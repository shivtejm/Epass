# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Notifications (Resend - https://resend.com, free tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key

# WhatsApp Notifications (optional)
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER=your_whatsapp_phone_number

# Backend URL (for frontend to call backend API)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Webhook Secret (for payment verification)
WEBHOOK_SECRET=epass-webhook-secret-change-me
